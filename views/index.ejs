<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>오늘의 게시판</title>
    <!-- 나중에 꾸미기 위해 CSS 파일을 연결해 둔다 -->
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- 상단 헤더 영역 -->
    <header>
        <h1>오늘의 게시판</h1>
        <button id="write-btn">+ 글쓰기</button>
    </header>

    <!-- 메인 게시글 목록 영역 -->
    <main>
        <!-- 게시글이 0개일 때 -->
        <% if (posts.length === 0) { %>
            <div class="empty-state">
                <p>게시글이 없습니다</p>
                <p>첫 글을 남겨보세요 (게시글 0개일 때)</p>
            </div>
        <% } else { %>
            <!-- 게시글이 있을 때: for문으로 카드를 하나씩 그린다 -->
            <% for(let i = 0; i < posts.length; i++) { %>
                <article class="post-card">
                    <h2><a href="/posts/<%= posts[i].id %>"><%= posts[i].title %></a></h2>
                    <p class="content-preview"><%= posts[i].content %></p>
                    
                    <div class="card-bottom">
                        <span class="date"><%= posts[i].date %></span>
                        <div class="stats">
                            <span class="likes">♥ <%= posts[i].likes %></span>
                            <!-- 댓글 배열의 길이를 구해서 개수를 표시한다 -->
                            <span class="comments">댓글 <%= posts[i].comments.length %></span>
                        </div>
                    </div>
                </article>
            <% } %>
        <% } %>
    </main>
</body>
</html>