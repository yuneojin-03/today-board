<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>상세보기 - 오늘의 게시판</title>
    <!-- 어제 만든 CSS 파일을 똑같이 연결한다 -->
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- 상단 헤더 (목록으로 돌아가기 & 삭제 버튼) -->
    <header>
        <a href="/" class="back-btn">← 목록으로</a>
        <button class="delete-post-btn">삭제</button>
    </header>

    <main>
        <!-- 게시글 본문 영역 -->
        <article class="post-detail">
            <h1><%= post.title %></h1>
            
            <div class="card-bottom post-meta">
                <span class="date"><%= post.date %></span>
                <span class="likes">♥ <%= post.likes %></span>
            </div>
            
            <div class="post-content">
                <!-- 본문의 줄바꿈을 유지하기 위해 CSS로 처리할 예정이다 -->
                <%= post.content %>
            </div>
        </article>

        <!-- 댓글 영역 -->
        <section class="comment-section">
            <h3>댓글 <%= post.comments.length %></h3>
            
            <!-- 댓글 입력 창 -->
            <div class="comment-input-box">
                <input type="text" placeholder="댓글을 입력하세요" id="comment-input">
                <button class="comment-submit-btn">등록</button>
            </div>

            <!-- 댓글 목록 -->
            <ul class="comment-list">
                <% if (post.comments.length === 0) { %>
                    <li class="empty-comment">아직 댓글이 없습니다. 첫 댓글을 남겨보세요.</li>
                <% } else { %>
                    <!-- 반복문으로 댓글을 하나씩 그립니다 -->
                    <% for(let i = 0; i < post.comments.length; i++) { %>
                        <li class="comment-item">
                            <span class="comment-text"><%= post.comments[i].content %></span>
                            <div class="comment-right">
                                <span class="comment-time"><%= post.comments[i].date %></span>
                                <!-- data-id 속성 추가 -->
                                <button class="delete-comment-btn" data-id="<%= post.comments[i].id %>">삭제</button>
                            </div>
                        </li>
                    <% } %>
                <% } %>
            </ul>
        </section>
    </main>
    <!-- 브라우저에서 동작할 JS 파일 연결 -->
    <script src="/main.js"></script>
</body>
</html>